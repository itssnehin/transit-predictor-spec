# Copy to .env and adjust as needed. .env is gitignored; never commit secrets.

# --- TransLink GTFS-Realtime feeds ---
# Verify current paths before building (see docs/DATA.md). No API key required.
TRANSLINK_VEHICLE_POSITIONS_URL=https://gtfsrt.api.translink.com.au/api/realtime/SEQ/VehiclePositions
TRANSLINK_TRIP_UPDATES_URL=https://gtfsrt.api.translink.com.au/api/realtime/SEQ/TripUpdates
TRANSLINK_ALERTS_URL=https://gtfsrt.api.translink.com.au/api/realtime/SEQ/Alerts

# --- Kafka (Redpanda) ---
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# --- MinIO (S3-compatible object store) ---
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_ENDPOINT=http://localhost:9000

# --- Postgres (warehouse stand-in) ---
POSTGRES_USER=transit
POSTGRES_PASSWORD=transit
POSTGRES_DB=transit
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
